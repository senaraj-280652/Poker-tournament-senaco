<?xml version="1.0" encoding="UTF-8"?>
<!--
  Projet WiX Toolset (v5) décrivant l'installateur .msi du Gestionnaire de
  Tournoi de Poker. Suppose que PyInstaller (voir windows/poker_tournament.spec,
  mode "onedir") a déjà généré le dossier
  $(var.Dist)\PokerTournament\ (contenant PokerTournament.exe et un
  sous-dossier _internal\ avec toutes les DLL/ressources) dans le dossier
  passé via la variable de préprocesseur "Dist" (par défaut windows/dist,
  positionnée par windows/build.ps1). L'exe est déclaré explicitement ;
  le contenu de _internal\ est harvesté récursivement (élément <Files>,
  sans avoir besoin de heat.exe) — pas un simple .exe unique :
  PokerTournament.exe a besoin de son _internal\ à côté pour démarrer.

  Construction manuelle (depuis la racine du dépôt) :
    wix build windows\app.wxs -arch x64 -ext WixToolset.UI.wixext ^
        -d Dist=windows\dist -out windows\dist\PokerTournament-16.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?ifndef Dist?>
  <?define Dist = "windows/dist" ?>
  <?endif?>

  <Package Name="Gestionnaire de Tournoi de Poker"
           Manufacturer="Raj Juganaikloo"
           Version="1.2.23"
           UpgradeCode="B0D02965-BECE-4162-856C-144E0675F6AE"
           Language="1036"
           Compressed="yes"
           InstallerVersion="500">
    <!-- UpgradeCode changé en 1.2.1 (l'ancien, 1702C0EB-14D2-4A17-B3B2-
         E1042B9298D3, coïncidait par malchance avec celui d'un tout
         autre logiciel installé chez un club utilisateur — Windows
         Installer proposait donc de LE désinstaller en pensant remplacer
         une ancienne version du nôtre !). Celui-ci vient de
         `python3 -c "import uuid; print(uuid.uuid4())"`, donc garanti
         unique. À conserver identique d'une version à l'autre à partir
         de maintenant (voir windows/README.md). -->

    <SummaryInformation Description="Installateur - Gestionnaire de Tournoi de Poker" />

    <MajorUpgrade
        DowngradeErrorMessage="Une version plus récente du Gestionnaire de Tournoi de Poker est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Icône (logo Sena Computer) utilisée par les raccourcis Bureau et
         Menu Démarrer ci-dessous. PokerTournament.exe l'embarque déjà
         (voir windows/poker_tournament.spec) ; la redéclarer ici via
         Icon/IconIndex est la façon standard WiX de fixer explicitement
         l'icône d'un raccourci plutôt que de compter sur l'extraction
         automatique depuis l'exécutable cible. -->
    <Icon Id="AppIcon.ico" SourceFile="windows\assets\app_icon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Gestionnaire de Tournoi de Poker">
        <!-- L'exécutable garde un Id fixe (PokerTournamentEXE) car les
             raccourcis Bureau/Menu Démarrer ci-dessous le référencent
             explicitement par cet Id (Target="[#PokerTournamentEXE]") —
             un <Files> harvesté ne permet pas de fixer l'Id d'un fichier
             précis à l'intérieur du lot. -->
        <Component Id="MainExecutable" Guid="*">
          <File Id="PokerTournamentEXE"
                Source="$(var.Dist)/PokerTournament/PokerTournament.exe"
                KeyPath="yes" />
        </Component>
        <!-- Sous-dossier créé par PyInstaller à côté de l'exe (mode
             onedir) : toutes ses DLL/dépendances. Déclaré ici comme
             simple sous-répertoire d'INSTALLFOLDER (même nom, _internal),
             peuplé ci-dessous par harvesting — voir ComponentGroup
             "AppFiles". -->
        <Directory Id="INTERNALDIR" Name="_internal" />
      </Directory>
    </StandardDirectory>

    <!-- Contenu de _internal\ (DLL Python/Tkinter/OpenCV/Pillow,
         help_content.json, splash...) : harvesté récursivement dans
         INTERNALDIR, en conservant sa propre arborescence de
         sous-dossiers. Seul ce sous-dossier est harvesté (pas tout
         PokerTournament\, qui contient aussi l'exe déjà déclaré ci-dessus
         avec un Id fixe) — pas besoin d'exclusion.

         ATTENTION, piège WiX confirmé (issue GitHub wixtoolset/issues
         #8163, classée "notabug" par les mainteneurs — donc un
         comportement voulu, pas un bug à surveiller pour une future
         version) : Files/@Include résout un chemin RELATIF par rapport
         au dossier qui CONTIENT ce fichier .wxs (donc "windows/" ici),
         PAS par rapport au dossier depuis lequel "wix build" est lancé
         (la racine du dépôt) — contrairement à File/@Source (utilisé pour
         l'exe ci-dessus), qui LUI se résout bien par rapport à la racine
         du dépôt via $(var.Dist)="windows/dist". Utiliser $(var.Dist) ici
         aurait donc pointé vers "windows/windows/dist/..." (inexistant) :
         d'où un motif écrit en dur relatif à windows/ (donc sans le
         préfixe "windows/"), et non $(var.Dist). Deux versions (1.2.19
         et 1.2.20) ont échoué silencieusement à cause de ce piège : le
         build "réussissait" (Files match 0 fichier sans la moindre
         erreur ni le moindre avertissement), mais produisait un .msi de
         8 Mo au lieu de ~78 Mo, avec un PokerTournament.exe privé de
         toutes ses DLL — repéré seulement en comparant la taille du
         .msi obtenu à celle des versions précédentes. -->
    <ComponentGroup Id="AppFiles" Directory="INTERNALDIR">
      <Files Include="dist/PokerTournament/_internal/**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Gestionnaire de Tournoi de Poker">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Poker Senaco"
                    Description="Gestionnaire de tournoi de poker multi-tables"
                    Target="[#PokerTournamentEXE]"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico"
                    IconIndex="0" />
          <RemoveFolder Id="CleanUpProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                          Key="Software\PokerTournament"
                          Name="StartMenuShortcutInstalled"
                          Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="Poker Senaco"
                  Description="Gestionnaire de tournoi de poker multi-tables"
                  Target="[#PokerTournamentEXE]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  IconIndex="0" />
        <RegistryValue Root="HKCU"
                        Key="Software\PokerTournament"
                        Name="DesktopShortcutInstalled"
                        Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Gestionnaire de Tournoi de Poker" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- WIXUI_INSTALLDIR doit correspondre à l'Id du <Directory> ci-dessus
         (INSTALLFOLDER) : c'est ce qui indique à WixUI_InstallDir quel
         dossier proposer/laisser modifier à l'écran "Choisir le dossier
         d'installation" (WixUI_Minimal, utilisé jusqu'ici, ne montrait
         pas cet écran et installait toujours dans le même dossier par
         défaut sous Program Files). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="windows\License.rtf" />

  </Package>
</Wix>
