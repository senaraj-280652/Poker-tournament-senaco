# Données de tournoi (personnelles, propres à chaque partie) — pas du code
*.tournoi

# Exports générés par l'application (résultats, synthèses, grilles de
# gains...) — jamais du code source, propres à chaque utilisation.
*.xlsx
*.csv

# Fichiers système macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Artefacts de build de l'installateur Windows (.msi) — régénérés par
# windows/build.ps1 ou la GitHub Action, jamais versionnés (voir
# windows/README.md).
windows/venv/
windows/build/
windows/dist/

# Artefacts de build de l'installateur macOS (.dmg) — régénérés par
# macos/build_dmg.sh, jamais versionnés (voir macos/README.md).
macos/venv/
macos/build/
macos/dist/

# Dossiers/archives de dépose ponctuelle (téléchargements, pas du code source)
files/
files [0-9]*/
files.zip

# Réglages locaux de l'outil Claude Code (spécifiques à cette machine)
.claude/

# Clé secrète du verrou de licence (voir license.py) — NE JAMAIS versionner :
# ce dépôt est public, un secret commité permettrait de fabriquer de fausses
# licences. Généré une seule fois localement, réinjecté à chaque build.
_license_secret.py

# Fichiers verrous temporaires de Microsoft Word (créés pendant l'édition,
# supprimés automatiquement à la fermeture du document)
~$*.doc
~$*.docx
